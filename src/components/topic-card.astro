---
import { Icon } from 'astro-icon/components';
import type { TopicNode } from '../utils/topics';

interface Props {
  topic: TopicNode;
  eyebrow?: string;
}

const { topic, eyebrow } = Astro.props;
const kind = topic.isColumn || topic.children.length > 0 ? '专栏' : '文章';
---

<a
  href={topic.href}
  class="topic-card group relative flex flex-col gap-4 p-6 bg-accent/5 border border-accent/10 rounded-2xl hover:border-accent/40 hover:bg-accent/10 hover:shadow-[0_0_24px_color-mix(in_srgb,var(--color-accent)_12%,transparent)] transition-all duration-300"
>
  <div class="flex items-start justify-between gap-3">
    <div class="w-12 h-12 rounded-xl bg-accent/15 border border-accent/20 flex items-center justify-center shrink-0">
      <Icon name={topic.icon || 'mdi:notebook-outline'} class="w-6 h-6 text-accent" />
    </div>
    <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border border-accent/20 text-accent/80">
      {eyebrow || kind}
    </span>
  </div>

  <div class="space-y-2">
    <h3 class="text-xl font-heading font-bold text-maintext group-hover:text-accent transition-colors">
      {topic.title}
    </h3>
    {topic.description && (
      <p class="text-subtext text-sm font-body leading-relaxed line-clamp-3">
        {topic.description}
      </p>
    )}
  </div>

  <div class="mt-auto flex items-center justify-between gap-3 pt-2">
    <div class="flex flex-wrap gap-2">
      {topic.tags.slice(0, 3).map((tag) => (
        <span class="rounded-md text-[10px] px-2 py-1 bg-accent/5 border border-accent/10 text-accent/80">
          {tag}
        </span>
      ))}
      {topic.children.length > 0 && (
        <span class="rounded-md text-[10px] px-2 py-1 bg-accent/5 border border-accent/10 text-accent/80">
          {topic.children.length} 篇
        </span>
      )}
    </div>
    <span class="text-accent text-xs font-body font-semibold tracking-wide inline-flex items-center gap-1">
      进入
      <Icon name="mdi:arrow-right" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
