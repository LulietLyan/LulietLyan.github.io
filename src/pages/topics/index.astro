---
import PageShell from '../../components/page-shell.astro';
import TopicCard from '../../components/topic-card.astro';
import { getTopicForest } from '../../utils/topics';

const forest = await getTopicForest();
---

<PageShell title="Topics · Lyan" description="Topic index: Computer Network, Operating System, MySQL, Redis, Message Queue, Golang, and Projects.">
  <section class="section-container max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-accent/80 mb-3">Archive</p>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-maintext mb-4">
        Topics
      </h1>
      <p class="text-subtext font-body max-w-2xl leading-relaxed">
        Read by column. Nested folders become nested columns, with no depth limit.
      </p>
    </div>

    {forest.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {forest.map((topic) => (
          <TopicCard topic={topic} eyebrow="Column" />
        ))}
      </div>
    ) : (
      <p class="text-subtext">No topics yet. Add a folder under <code class="text-accent">topics/</code> and write a README.</p>
    )}
  </section>
</PageShell>
